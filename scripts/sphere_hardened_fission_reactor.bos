#define TA			// This is a TA script

#include "sfxtype.h"
#include "exptype.h"

piece  base,b2,b3,b4,b5,b6,b7,b8;



Killed(severity, corpsetype)
{
	if( severity <= 50 )
	{
		explode b3 type SHATTER;
		return (1);
	}

	explode base type SHATTER | EXPLODE_ON_HIT | BITMAP1;
	explode b2 type SHATTER;
	explode b3 type SHATTER;
	return (2);
}
