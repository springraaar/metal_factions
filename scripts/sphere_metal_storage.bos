#define TA			// This is a TA script

#include "sfxtype.h"
#include "exptype.h"

piece  base,b2,ss; 

Killed(severity, corpsetype)
{
	if( severity <= 50 )
	{
		explode base type BITMAPONLY | BITMAP1;
		explode ss type BITMAPONLY | BITMAP1;
		return (1);
	}
	explode base type SHATTER | BITMAP4;
	explode ss type SHATTER | BITMAP4;
	return (2);
}
