#define TA			// This is a TA script

#include "sfxtype.h"
#include "exptype.h"

piece  base,b2,b3,b4;

Create()
{
	return (0);
}


Killed(severity, corpsetype)
{
	if( severity <= 50 )
	{
		return (1);
	}
	explode base type SHATTER;
	explode b2 type SHATTER;
	explode b3 type SHATTER;
	explode b4 type SHATTER;
	return (2);
}
