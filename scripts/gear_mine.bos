#define TA			// This is a TA script

#include "sfxtype.h"
#include "exptype.h"

piece  base, top, bottom, center;


Create()
{
	return (0);
}

Killed(severity, corpsetype)
{
	explode top type SHATTER | EXPLODE_ON_HIT | BITMAP3;
	explode bottom type SHATTER | EXPLODE_ON_HIT | BITMAP3;
	return (0);
}
