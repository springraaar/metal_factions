#define TA			// This is a TA script

#include "sfxtype.h"
#include "exptype.h"

piece  base, lwing, rwing, lbody, rbody, lw2, rw2, center, weapon1,weapon2, firept1, firept2, ljet, rjet, ljp2, rjp2, b2;

static-var  statechg_DesiredState, statechg_StateChanging, desiredState, stateChanging, gun_1;



activatescr()
{
	sleep 100;
}


deactivatescr()
{
	sleep 24;
}

InitState()
{
	desiredState = 1;
	stateChanging = 0;
}

RequestState(requestedstate, currentstate)
{
	if( stateChanging )
	{
		desiredState = requestedstate;
		return (0);
	}
	stateChanging = 1;
	currentstate = desiredState;
	desiredState = requestedstate;
	while( desiredState != currentstate )
	{
		if( desiredState == 0 )
		{
			call-script activatescr();
			currentstate = 0;
		}
		if( desiredState == 1 )
		{
			call-script deactivatescr();
			currentstate = 1;
		}
	}
	stateChanging = 0;
}


Create()
{
	statechg_DesiredState = 0;
	statechg_StateChanging = 0;
	gun_1 = 0;
	call-script InitState();
}

Activate()
{
	start-script RequestState(0);
}

Deactivate()
{
	start-script RequestState(1);
}

Shot1()
{
	if (gun_1 == 0)
	{
		gun_1 = 1;
	}
	else
	{
		gun_1 = 0;
	}
	return (0);
}

QueryPrimary(piecenum)
{
	if( gun_1 == 0)
	{
		piecenum = firept1;
	}
	else
	{
		piecenum = firept2;
	}
	return (0);
}

AimFromPrimary(piecenum)
{
	piecenum = b2;
}

AimPrimary(heading,pitch)
{
	return (1);
}


Killed(severity, corpsetype)
{
	explode center type SHATTER | EXPLODE_ON_HIT | BITMAP5;
	explode lwing type SHATTER | EXPLODE_ON_HIT | BITMAP5;
	explode rwing type SHATTER | EXPLODE_ON_HIT | BITMAP5;
	return(0);
}
