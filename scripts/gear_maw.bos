#define TA			// This is a TA script

#include "sfxtype.h"
#include "exptype.h"

#define HEADING_TOLERANCE	<30>
#define PITCH_TOLERANCE		<20>

piece  base,b2, lwing, rwing, lbody, rbody, barrelsup, sleeve, flare1,flare2,flare3, ljet,ljet2, rjet,rjet2,c2,ljp,rjp,ljp2,rjp2,bj1,bj2,bj3,bj4,jp1,jp2,jp3,jp4,jawtop,jawbottom;

static-var isFlying, isOpen, gun_1;

#include "aimhelper1.h"


#define SIG_AIM 	2



Open() {
	set ARMORED to FALSE;

	turn jawtop to x-axis <-30> speed <180>;
	turn jawbottom to x-axis <30> speed <180>;
	
	wait-for-turn jawtop around x-axis;

	isOpen = TRUE;
	return (0);
}

Close() {
	isOpen = FALSE;
	turn jawtop to x-axis <0> speed <180>;
	turn jawbottom to x-axis <0> speed <180>;
	
	wait-for-turn jawtop around x-axis;

	set ARMORED to TRUE;
	return (0); 
}


SmokeUnit(healthpercent, sleeptime, smoketype) {
	while( get BUILD_PERCENT_LEFT )	{
		sleep 400;
	}
	while( TRUE ) {
		healthpercent = get HEALTH;
		if( healthpercent < 66 ) {
			smoketype = 256 | 2;
			if( Rand( 1, 66 ) < healthpercent )	{
				smoketype = 256 | 1;
			}
			emit-sfx smoketype from base;
		}
		sleeptime = healthpercent * 50;
		if( sleeptime < 200 ) {
			sleeptime = 200;
		}
		sleep sleeptime;
	}
}

RestoreAfterDelay() {
	sleep 2500;
	call-script stopAimHelper1(<100>,<100>);
	turn sleeve to x-axis <0.000000> speed <100.005495>;
	turn b2 to y-axis <0.000000> speed <100.005495>;
	call-script Close();
	return (0);
}

Create() {
	turn jp1 to x-axis <-90> now;
	turn jp2 to x-axis <-90> now;
	turn jp3 to x-axis <-90> now;
	turn jp4 to x-axis <-90> now;
	spin barrelsup around z-axis speed <720>;
	isFlying = FALSE;
	isOpen = FALSE;
	gun_1 = 0;
	call-script stopAimHelper1(<1000>,<1000>);
	start-script SmokeUnit();
}

Activate() {
	isFlying = TRUE;
}

Deactivate() {
	isFlying = FALSE;
}


AimFromPrimary(piecenum) {
	piecenum = sleeve;
	return (0);
}

AimPrimary(heading, pitch) {
	if(!isFlying) {
		return (0);
	}
	if( !isOpen) {
		start-script Open();
		return (0);
	}
	turn sleeve to x-axis <0.000000> - pitch speed <370.005495>;
	turn b2 to y-axis heading speed <370.005495>;	
	call-script updateAimHelper1(heading,pitch,<370>,<370>,HEADING_TOLERANCE,PITCH_TOLERANCE);	
	signal SIG_AIM;
	set-signal-mask SIG_AIM;
	
	//while (heading < <-20> || heading > <20>) {
	//	sleep 100;
	//}
	
	if (!aimReady1 ) {
		wait-for-turn b2 around y-axis;
		wait-for-turn sleeve around x-axis;
	}
	start-script RestoreAfterDelay();
	return (1);
}

Shot1(){
	if (gun_1 == 0) {
		emit-sfx 1024+0 from flare1;
		gun_1 = 1;
		return(0);
	}
	if (gun_1 == 1) {
		emit-sfx 1024+0 from flare2;
		gun_1 = 2;
		return(0);
	}
	if (gun_1 == 2) {
		emit-sfx 1024+0 from flare3;
		gun_1 = 0;
		return(0);
	}
}

QueryPrimary(piecenum) {
	if (gun_1 == 0) {
		piecenum = flare1;
		return(0);
	}
	if (gun_1 == 1) {
		piecenum = flare2;
		return(0);
	}
	if (gun_1 == 2) {
		piecenum = flare3;
		return(0);
	}
}

Killed(severity, corpsetype) {
	explode sleeve type SHATTER | EXPLODE_ON_HIT | BITMAP5;
	explode lwing type SHATTER | EXPLODE_ON_HIT | BITMAP5;
	explode rwing type SHATTER | EXPLODE_ON_HIT | BITMAP5;
	explode ljet type SHATTER | EXPLODE_ON_HIT | BITMAP5;
	explode rjet type SHATTER | EXPLODE_ON_HIT | BITMAP5;
}
