#define TA			// This is a TA script

#include "sfxtype.h"
#include "exptype.h"

piece  base, base2,turret,slpt, sleeve, barrel, flash,sleeve2,barrel2,flash2,floatbase,fb2;

static-var  gun_1, currentHeading, currentPitch, isFloating;


#define HEADING_TOLERANCE	<15.000000>
#define PITCH_TOLERANCE		<25.000000>

// Signal definitions
#define SIG_AIM				2




Create()
{
	hide flash;
	hide flash2;
	hide floatbase;
	hide fb2;
	isFloating = FALSE;
	if ( GET GROUND_WATER_HEIGHT(GET UNIT_XZ) < [0])
	{
		isFloating = TRUE;
		show floatbase;
		show fb2;
	}	
	gun_1=0;
	currentHeading = <0>;
	currentPitch = <0>;
}


RestoreAfterDelay()
{
	sleep DEFAULT_WEAPON_RESTORE_DELAY;
	currentHeading = <0>;
	currentPitch = <0>;
	turn turret to y-axis <0.000000> speed <90.016484>;
	turn slpt to x-axis <0.000000> speed <50.005495>;
}

AimPrimary(heading, pitch)
{
	signal SIG_AIM;
	set-signal-mask SIG_AIM;
	turn turret to y-axis heading speed <420.038462>;
	turn slpt to x-axis <0.000000> - pitch speed <450.000000>;
	if ( get ABS(heading - currentHeading)  > HEADING_TOLERANCE || get ABS(pitch - currentPitch) > PITCH_TOLERANCE )
	{
		wait-for-turn turret around y-axis;
		wait-for-turn slpt around x-axis;
		currentHeading = heading;
		currentPitch = pitch;
	}
	start-script RestoreAfterDelay();
	return (1);
}

FirePrimary()
{
	if( gun_1 == 0 )
	{
		emit-sfx 1024 + 0 from flash;
		sleep 100;
		gun_1 = 1;
	}
	else
	{
		emit-sfx 1024 + 0 from flash2;
		sleep 100;
		gun_1 = 0;
	}
}

AimFromPrimary(piecenum)
{
	piecenum = turret;
}

QueryPrimary(piecenum)
{
	if( gun_1 == 0 )
	{
		piecenum = flash;
	}
	else
	{
		piecenum = flash2;
	}
}


Killed(severity, corpsetype)
{
	if( severity <= 50 )
	{
		if (isFloating) 
		{
			corpsetype = 1;
		}
		if (!isFloating) 
		{
			corpsetype = 2;
		}
		explode turret type SHATTER | BITMAP1;
		explode sleeve type SHATTER | BITMAP1;
		return corpsetype;
	}

	corpsetype = 3;
	explode turret type SHATTER | BITMAP1;
	explode sleeve type SHATTER | BITMAP1;
	explode barrel type SHATTER | BITMAP1;
	explode barrel2 type SHATTER | BITMAP1;
	explode base2 type SHATTER | BITMAP1;
	return corpsetype;
}
