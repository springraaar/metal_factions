#define TA			// This is a TA script

#include "sfxtype.h"
#include "exptype.h"


piece  base, hull, bottom, h2, h3, wake1, chargept;


// Signal definitions
#define SIG_MOVE			2



StartMoving() {
	signal SIG_MOVE;
	set-signal-mask SIG_MOVE;
	while( TRUE ) {
		emit-sfx 2 from wake1;
		sleep 300;
	}
	return (0);
}

StopMoving() {
	signal SIG_MOVE;
	return (0);
}

AimPrimary(heading, pitch) {
	return (1);
}

FirePrimary() {
	return (0);
}

AimFromPrimary(piecenum) {
	piecenum = chargept;
	return (0);
}

QueryPrimary(piecenum) {
	piecenum = chargept;
	return (0);
}


Killed(severity, corpsetype) {
	if( severity <= 50 ) {
		explode h2 type SHATTER;
		explode h3 type SHATTER;
		return (1);
	}

	explode hull type SHATTER;
	explode bottom type SHATTER;
	explode h2 type SHATTER;
	explode h3 type SHATTER;
	return (2);
}
