#define TA			// This is a TA script

#include "sfxtype.h"
#include "exptype.h"

piece  base,base2,rwing,lwing,dish,dish2,ear1,ear2,ljp,rjp;

static-var  bMoving;

// Signal definitions
#define SIG_ACTIVATE			2


Create()
{
	bMoving = FALSE;
	return (0);
}

Activate()
{
	signal SIG_ACTIVATE;
	set-signal-mask SIG_ACTIVATE;
	spin dish around y-axis speed <200.021978>;
	return (0);
}

Deactivate()
{
	signal SIG_ACTIVATE;
	set-signal-mask SIG_ACTIVATE;
	stop-spin dish around y-axis decelerate <10.000000>;
	return (0);
}

StartMoving()
{
	bMoving = TRUE;
	return (0);
}

StopMoving()
{
	bMoving = FALSE;
	return (0);
}

Killed(severity, corpsetype)
{
	explode base2 type SHATTER | EXPLODE_ON_HIT | BITMAP4;
	explode dish type SHATTER | EXPLODE_ON_HIT | BITMAP4;
	explode dish2 type SHATTER | EXPLODE_ON_HIT | BITMAP4;
	explode ear1 type SHATTER | EXPLODE_ON_HIT | BITMAP4;
	explode ear2 type SHATTER | EXPLODE_ON_HIT | BITMAP4;
	return (0);
}
