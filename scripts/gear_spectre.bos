MotionControl(moving, aiming, justMoved)
{
	while( TRUE )
	{
		justMoved = TRUE;
		while( TRUE )
		{
			moving = bMoving;
			if( moving )
			{
				call-script walk();
				justMoved = TRUE;
			}
			else
			{
				if( justMoved )
				{
					move lleg to z-axis [0.000000] speed [20.000000];
					move rleg to z-axis [0.000000] speed [20.000000];
					move lleg to y-axis [0.000000] speed [20.000000];
					move rleg to y-axis [0.000000] speed [20.000000];
					turn lleg to x-axis <0.000000> speed <200.000000>;
					turn rleg to x-axis <0.000000> speed <200.000000>;

					justMoved = FALSE;
				}
				sleep 100;
			}
		}
	}
}

Create()
{
	bMoving = FALSE;
	start-script MotionControl();
	return (0);
}

Activate()
{
	signal SIG_ACTIVATE;
	set-signal-mask SIG_ACTIVATE;
	spin t3 around y-axis speed <360.021978>;
	return (0);
}

Deactivate()
{
	signal SIG_ACTIVATE;
	set-signal-mask SIG_ACTIVATE;
	turn t3 to y-axis <0.000000> speed <360.021978>;
	wait-for-turn t3 around y-axis;
	return (0);
}

StartMoving()
{
	bMoving = TRUE;
	return (0);
}

StopMoving()
{
	bMoving = FALSE;
	return (0);
}


Killed(severity, corpsetype)
{
	if( severity <= 50 )
	{
		explode tbase type SHATTER | EXPLODE_ON_HIT | BITMAP4;
		explode t2 type SHATTER | EXPLODE_ON_HIT | BITMAP4;
		explode t3 type SHATTER | EXPLODE_ON_HIT | BITMAP4;
		explode fork type SHATTER | EXPLODE_ON_HIT | BITMAP4;
		return (1);
	}
	explode tbase type SHATTER | EXPLODE_ON_HIT | BITMAP4;
	explode t2 type SHATTER | EXPLODE_ON_HIT | BITMAP4;
	explode t3 type SHATTER | EXPLODE_ON_HIT | BITMAP4;
	explode fork type SHATTER | EXPLODE_ON_HIT | BITMAP4;
	return (2);
}
