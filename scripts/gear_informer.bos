#define TA			// This is a TA script

#include "sfxtype.h"
#include "exptype.h"

piece  base, dish, turret, t1,t2,t1cover,t2cover,body,left,right,b2;

#define SPEEDUP_FACTOR 	100

#include "tankthreads.h"

HitByWeapon(Func_Var_1, Func_Var_2)
{
	turn base to z-axis Func_Var_2 speed <105.021978>;
	turn base to x-axis Func_Var_1 speed <105.021978>;
	wait-for-turn base around z-axis;
	wait-for-turn base around x-axis;
	turn base to z-axis <0.000000> speed <30.005495>;
	turn base to x-axis <0.000000> speed <30.005495>;
	return (0);
}

Create()
{
	start-script AnimateTracks();
	return (0);
}

Activate()
{
	spin turret around y-axis speed <100.021978>;
	return (0);
}

Deactivate()
{
	spin turret around y-axis speed <0.000000>;
	return (0);
}


Killed(severity, corpsetype)
{
	if( severity <= 50 )
	{
		explode dish type SHATTER | BITMAP2;
		explode body type SHATTER | EXPLODE_ON_HIT | BITMAP2;
		explode left type SHATTER | EXPLODE_ON_HIT | BITMAP2;
		explode right type SHATTER | EXPLODE_ON_HIT | BITMAP2;
		return (1);
	}
	explode base type SHATTER | BITMAP1;
	explode dish type SHATTER | EXPLODE_ON_HIT | BITMAP2;
	explode body type SHATTER | EXPLODE_ON_HIT | BITMAP2;
	explode turret type SHATTER | BITMAP3;
	return (2);
}
