#define TA			// This is a TA script

#include "sfxtype.h"
#include "exptype.h"

piece  base, lwing, rwing, lbody, rbody, lw2, rw2, center, c2, nanopt, ljet, rjet, b2, c3, ljp, rjp;

static-var  desiredState, stateChanging;

// signal definitions
#define SIG_ACTIVATION		8

activatescr()
{
	sleep 12;
}

deactivatescr()
{
	sleep 18;
}

InitState()
{
	desiredState = 1;
	stateChanging = 0;
}

RequestState(requestedstate, currentstate)
{
	if( stateChanging )
	{
		desiredState = requestedstate;
		return (0);
	}
	stateChanging = 1;
	currentstate = desiredState;
	desiredState = requestedstate;
	while( desiredState != currentstate )
	{
		if( desiredState == 0 )
		{
			call-script activatescr();
			currentstate = 0;
		}
		if( desiredState == 1 )
		{
			call-script deactivatescr();
			currentstate = 1;
		}
	}
	stateChanging = 0;
}

Create()
{
	call-script InitState();
}

Activate()
{
	signal SIG_ACTIVATION;
	start-script RequestState(0);
}

Deactivate()
{
	set-signal-mask SIG_ACTIVATION;
	sleep 2500;
	start-script RequestState(1);
}

StartBuilding()
{
	set INBUILDSTANCE to 1;
}

StopBuilding()
{
	set INBUILDSTANCE to 0;
}

QueryNanoPiece(piecenum)
{
	piecenum = nanopt;
}


Killed(severity, corpsetype)
{
	explode ljet type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP3;
	explode rjet type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP3;
	explode lwing type SHATTER | EXPLODE_ON_HIT | BITMAP5;
	explode rwing type SHATTER | EXPLODE_ON_HIT | BITMAP5;
	explode lw2 type SHATTER | EXPLODE_ON_HIT | BITMAP5;
	explode rw2 type SHATTER | EXPLODE_ON_HIT | BITMAP5;
	explode center type SHATTER | EXPLODE_ON_HIT | BITMAP5;
	return(0);
}
