#define TA			// This is a TA script

#include "sfxtype.h"
#include "exptype.h"

piece  base, flare, turret, sleeve, barrel;

// Signal definitions
#define SIG_AIM				2



Create()
{
	hide flare;
	return (0);
}

AimPrimary(heading, pitch)
{
	signal SIG_AIM;
	set-signal-mask SIG_AIM;
	turn turret to y-axis heading speed <6.000000>;
	turn sleeve to x-axis <0.000000> - pitch speed <4.000000>;
	wait-for-turn turret around y-axis;
	wait-for-turn sleeve around x-axis;
	return (1);
}

FirePrimary()
{

	move barrel to z-axis [-12.500000] now;
	emit-sfx 1024 + 0 from flare;
	sleep 250;
	move barrel to z-axis [0.000000] speed [7.500000];
	return (0);
}

TargetCleared(Func_Var_1)
{
	if( Func_Var_1 == 1 )
	{
		signal SIG_AIM;
		stop-spin turret around y-axis;
		stop-spin sleeve around x-axis;
	}
	return (0);
}

AimFromPrimary(piecenum)
{
	piecenum = turret;
	return (0);
}

QueryPrimary(piecenum)
{
	piecenum = flare;
	return (0);
}


Killed(severity, corpsetype)
{
	hide flare;
	if( severity <= 50 )
	{
		explode sleeve type SHATTER;
		explode barrel type SHATTER;
		return (1);
	}
	explode base type SHATTER;
	explode turret type SHATTER;
	explode sleeve type SHATTER;
	explode barrel type SHATTER;
	return (2);
}
