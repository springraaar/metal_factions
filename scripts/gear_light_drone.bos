#define TA			// This is a TA script

#include "sfxtype.h"
#include "exptype.h"

piece  base, lwing, rwing, lbody, rbody, center, weapon, firept, jet, b2,jp1;

static-var  desiredState, stateChanging,isFlying;



activatescr()
{
	if( !isFlying)
	{
		// nothing to do here
		sleep 50;
		isFlying = TRUE;
	}
	sleep 30;
}


deactivatescr()
{
	if( isFlying )
	{
		isFlying = FALSE;
		sleep 50;
		// nothing to do here
	}
	sleep 24;
}


InitState()
{
	desiredState = 1;
	stateChanging = 0;
}

RequestState(requestedstate, currentstate)
{
	if( stateChanging )
	{
		desiredState = requestedstate;
		return (0);
	}
	stateChanging = 1;
	currentstate = desiredState;
	desiredState = requestedstate;
	while( desiredState != currentstate )
	{
		if( desiredState == 0 )
		{
			call-script activatescr();
			currentstate = 0;
		}
		if( desiredState == 1 )
		{
			call-script deactivatescr();
			currentstate = 1;
		}
	}
	stateChanging = 0;
}


Create()
{
	isFlying = FALSE;
	call-script InitState();
}

Activate()
{
	start-script RequestState(0);
}

Deactivate()
{
	start-script RequestState(1);
}

AimPrimary()
{
	if(!isFlying)
	{
		return (0);
	}
	return (1);
}

firePrimary()
{
	emit-sfx 1024+0 from firept;
}

QueryPrimary(piecenum)
{
	piecenum = firept;
}

Killed(severity, corpsetype)
{
	explode center type SHATTER | EXPLODE_ON_HIT | BITMAP5;
	explode lwing type SHATTER | EXPLODE_ON_HIT | BITMAP5;
	explode rwing type SHATTER | EXPLODE_ON_HIT | BITMAP5;
	return(0);
}
