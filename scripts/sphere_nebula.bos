#define TA			// This is a TA script

#include "sfxtype.h"
#include "exptype.h"

#define HEADING_TOLERANCE	<30>
#define PITCH_TOLERANCE		<20>

piece  base,body,btop,bbot, flare,bwsup, turret, shieldpt, jp1,jp2,jp3,jp4,jp5,jp6,jp7,jp8,f1,f2,f3;

static-var  isFlying, gun_2, bAiming;


#include "aimhelper1.h"


// signal definitions
#define SIG_AIM		2


RestoreAfterDelay() {
	sleep DEFAULT_WEAPON_RESTORE_DELAY;
	call-script stopAimHelper1(<100>,<100>);
	turn turret to x-axis <0> speed <100>;
	bAiming = FALSE;
}

aimFX(){
	while(TRUE) {
		if (bAiming) {
			emit-sfx 1024+2 from flare;
		}
		sleep 50;
	}
}

Create(){
	isFlying = FALSE;
	turn jp1 to x-axis <-90.000000> now;
	turn jp2 to x-axis <-90.000000> now;
	turn jp3 to x-axis <-90.000000> now;	
	turn jp4 to x-axis <-90.000000> now;
	turn jp5 to x-axis <-90.000000> now;
	turn jp6 to x-axis <-90.000000> now;	
	turn jp7 to x-axis <-90.000000> now;
	turn jp8 to x-axis <-90.000000> now;

	gun_2 = 0;
	bAiming = FALSE;
	call-script stopAimHelper1(<1000>,<1000>);
	start-script aimFX();
}

Activate() {
	isFlying = TRUE;
}

Deactivate() {
	isFlying = FALSE;
}

FirePrimary() {
	emit-sfx 1024 from flare;
	return (0);
}

QueryPrimary(piecenum) {
	piecenum = flare;
}

AimFromPrimary(piecenum)
{
	piecenum = flare;
	return (0);
}

AimPrimary(heading, pitch) {
	if(!isFlying) {
		return (0);
	}
	call-script updateAimHelper1(heading,pitch,<400>,<400>,HEADING_TOLERANCE,PITCH_TOLERANCE);	
	signal SIG_AIM;
	set-signal-mask SIG_AIM;
	bAiming=TRUE;
	
	while (pitch < <-80> || pitch > <80>) {
		sleep 100;
	}
	turn turret to y-axis heading speed <400.005495>;		
	if (!aimReady1 ) {
		wait-for-turn turret around y-axis;
	}
	start-script RestoreAfterDelay();
	return (1);
}


FireWeapon2() {
	if (gun_2 == 0) {
		emit-sfx 1024+1 from f1;
		sleep 100;
		gun_2 = 1;
		return (0);
	}
	if (gun_2 == 1) {
		emit-sfx 1024+1 from f2;
		sleep 100;
		gun_2 = 2;
		return (0);
	}
	if (gun_2 == 2) {
		emit-sfx 1024+1 from f3;
		sleep 100;
		gun_2 = 0;
		return (0);
	}	
}

QueryWeapon2(piecenum) {
	if (gun_2 == 0) {
		piecenum = f1;
		return (0);
	}
	if (gun_2 == 1) {
		piecenum = f2;
		return (0);
	}
	if (gun_2 == 2) {
		piecenum = f3;
		return (0);
	}
}

AimFromWeapon2(piecenum) {
	piecenum = bwsup;
	return (0);
}

AimWeapon2(heading, pitch) {
	return (1);
}


QueryWeapon3(piecenum) {
	piecenum=shieldpt;
}

AimFromWeapon3(piecenum)
{
	piecenum = shieldpt;
	return (0);
}


Killed(severity, corpsetype) {
	explode turret type SHATTER | EXPLODE_ON_HIT | BITMAP1;
	explode bbot type SHATTER | EXPLODE_ON_HIT | BITMAP1;
	explode body type SHATTER | EXPLODE_ON_HIT | BITMAP1;
	explode btop type SHATTER | EXPLODE_ON_HIT | BITMAP1;
	return(0);
}
