#define TA			// This is a TA script

#include "sfxtype.h"
#include "exptype.h"

piece  base, b2,b3,b4,lon,ron,loff,roff;


Activate() {
	show lon;
	show ron;
	hide loff;
	hide roff;
	return (0);
}

Deactivate() {
	hide lon;
	hide ron;
	show loff;
	show roff;
	return (0);
}


Killed(severity) {
	if( severity <= 50 )
	{
		explode loff type SHATTER;
		explode roff type SHATTER;
		return (1);
	}

	explode b3 type SHATTER;
	explode b4 type SHATTER;
	explode loff type SHATTER;
	explode roff type SHATTER;

	return (2);
}
