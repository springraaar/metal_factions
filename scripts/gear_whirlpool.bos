#define TA			// This is a TA script

#include "sfxtype.h"
#include "exptype.h"

piece  base, lwing, rwing, lbody, rbody, lw2, rw2, center, weapon, firept, ljet, rjet, b2, ljp,rjp,ljp2,rjp2;

static-var  isFlying, desiredState, stateChanging;



activatescr()
{
	sleep 100;
	isFlying = TRUE;
}


deactivatescr()
{
	sleep 100;
	isFlying = FALSE;
}

InitState()
{
	desiredState = 1;
	stateChanging = 0;
}

RequestState(requestedstate, currentstate)
{
	if( stateChanging )
	{
		desiredState = requestedstate;
		return (0);
	}
	stateChanging = 1;
	currentstate = desiredState;
	desiredState = requestedstate;
	while( desiredState != currentstate )
	{
		if( desiredState == 0 )
		{
			call-script activatescr();
			currentstate = 0;
		}
		if( desiredState == 1 )
		{
			call-script deactivatescr();
			currentstate = 1;
		}
	}
	stateChanging = 0;
}


Create()
{
	turn firept to x-axis <-45.000000> now;
	isFlying = FALSE;
	call-script InitState();
}

Activate()
{
	start-script RequestState(0);
}

Deactivate()
{
	start-script RequestState(1);
}

QueryPrimary(piecenum)
{
	piecenum = firept;
}

AimFromPrimary(piecenum)
{
	piecenum = firept;
}

AimPrimary()
{
	if(!isFlying)
	{
		return (0);
	}
	return (1);
}


Killed(severity, corpsetype)
{
	explode center type SHATTER | EXPLODE_ON_HIT | BITMAP5;
	explode lwing type SHATTER | EXPLODE_ON_HIT | BITMAP5;
	explode rwing type SHATTER | EXPLODE_ON_HIT | BITMAP5;
	return(0);
}
