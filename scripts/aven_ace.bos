#define TA			// This is a TA script

#include "sfxtype.h"
#include "exptype.h"

piece  base, rwing, lwing, tail, ljet, rjet, ljp, rjp, base2, base3, center, weapon,barrel,flare, front;

static-var  isFlying, bMoving, energyBoostedMovement;

lua_checkEnergy() { return 0; }


MotionControl(hasEnergy)
{
	hasEnergy = 1;
	while (TRUE)
	{
		bMoving = ((get CURRENT_SPEED) * 100 / (get MAX_SPEED)) > 70;

		// lua check for energy availability		
		call-script lua_checkEnergy(2000);
		hasEnergy = get LUA1;
		
		// update speed and activation state
		if (bMoving && hasEnergy)
		{
			energyBoostedMovement = TRUE;
		}
		if (!bMoving || !hasEnergy)
		{
			energyBoostedMovement = FALSE;
		}

		sleep 60;
	}
}


Effect()
{
	while (TRUE)
	{
		if (energyBoostedMovement)
		{
			emit-sfx 1024+1 from barrel;
		}

		sleep 30;
	}
}

activatescr()
{
	if( !isFlying)
	{
		sleep 500;
		isFlying = TRUE;
	}
	sleep 66;
}


deactivatescr()
{
	if( isFlying )
	{
		isFlying = FALSE;
		sleep 500;
	}
	sleep 66;
}


Create()
{
	energyBoostedMovement = FALSE;
	bMoving=FALSE;
	isFlying = FALSE;
	start-script MotionControl();
	start-script Effect();
}

Activate()
{
	isFlying = TRUE;
}

Deactivate()
{
	isFlying = FALSE;
}

AimPrimary()
{
	if(!isFlying)
	{
		return (0);
	}
	return (1);
}

FirePrimary()
{
	emit-sfx 1024+0 from flare;
}

QueryPrimary(piecenum)
{
	piecenum = flare;
}

Killed(severity, corpsetype)
{
	explode base2 type SHATTER | EXPLODE_ON_HIT | BITMAP5;
	explode lwing type SHATTER | EXPLODE_ON_HIT | BITMAP5;
	explode rwing type SHATTER | EXPLODE_ON_HIT | BITMAP5;
	explode base3 type SHATTER | EXPLODE_ON_HIT | BITMAP5;
	explode front type SHATTER | EXPLODE_ON_HIT | BITMAP5;
	explode center type SHATTER | EXPLODE_ON_HIT | BITMAP5;
	return (0);
}
